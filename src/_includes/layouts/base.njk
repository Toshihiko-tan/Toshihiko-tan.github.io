<!doctype html>
<html lang="{{ site.lang or 'en' }}">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  {%- set pageTitle = (title + " · " + site.name) if title else site.name %}
  {%- set pageDescription = description or site.description %}
  <title>{{ pageTitle }}</title>
  <meta name="description" content="{{ pageDescription }}">
  <meta name="author" content="{{ site.name }}">
  <link rel="canonical" href="{{ site.url }}{{ page.url }}">
  <meta property="og:type" content="{{ ogType or 'website' }}">
  <meta property="og:site_name" content="{{ site.name }}">
  <meta property="og:title" content="{{ title or site.name }}">
  <meta property="og:description" content="{{ pageDescription }}">
  <meta property="og:url" content="{{ site.url }}{{ page.url }}">
  <meta name="twitter:card" content="summary">
  <meta name="color-scheme" content="light dark">
  <link rel="icon" href="/favicon.svg" type="image/svg+xml">
  <link rel="alternate" type="application/atom+xml" title="{{ site.name }} · Blog" href="/feed.xml">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Inter:ital,opsz,wght@0,14..32,100..900;1,14..32,100..900&display=swap">
  <link rel="stylesheet" href="/assets/css/style.css?v={{ buildTime }}">
  <script>
    document.documentElement.classList.add("js");
    try { var t = localStorage.getItem("theme"); if (t === "dark" || t === "light") document.documentElement.dataset.theme = t; } catch (e) {}
  </script>
  <script src="/assets/js/site.js?v={{ buildTime }}" defer></script>
</head>
<body>
  <a class="skip-link" href="#main">Skip to content</a>
  {%- set elsewhere = [
    { "key": "email", "label": "Email", "icon": "mail" },
    { "key": "scholar", "label": "Google Scholar", "icon": "scholar" },
    { "key": "orcid", "label": "ORCID", "icon": "orcid" },
    { "key": "github", "label": "GitHub", "icon": "github" },
    { "key": "linkedin", "label": "LinkedIn", "icon": "linkedin" },
    { "key": "bluesky", "label": "Bluesky", "icon": "bluesky" },
    { "key": "x", "label": "X", "icon": "x" }
  ] %}

  <header class="site-header">
    <div class="container header-inner">
      <a class="site-title" href="/">
        <span class="site-title-label">Academic homepage</span>
        <span class="site-title-name">{{ site.name }}</span>
      </a>
      <nav class="site-nav" aria-label="Main">
        <ul>
          {%- for item in site.nav | published %}
          {%- set active = (page.url == item.url) or (item.url != "/" and page.url and page.url.startsWith(item.url)) %}
          <li><a href="{{ item.url }}"{% if active %} aria-current="page"{% endif %}><span class="nav-num">{{ '0' if loop.index < 10 }}{{ loop.index }}</span>{{ item.title }}</a></li>
          {%- endfor %}
        </ul>
      </nav>
      <button class="theme-toggle" type="button" aria-label="Switch between light and dark theme" title="Light / dark">{% icon "contrast" %}</button>
    </div>
  </header>

  {#- A slim rail on the left edge of wide screens: sideways copyright and icon links. #}
  <aside class="rail" aria-label="Elsewhere">
    <p class="rail-text">© {{ buildYear }} {{ site.name }}</p>
    <ul class="rail-icons">
      {%- for l in elsewhere %}
      {%- set href = site.links[l.key] %}
      {%- if href %}
      <li><a href="{{ ('mailto:' + href) if l.key == 'email' else href }}" aria-label="{{ l.label }}" title="{{ l.label }}">{% icon l.icon %}</a></li>
      {%- endif %}
      {%- endfor %}
    </ul>
  </aside>

  <main id="main" class="container">
    {{ content | safe }}
  </main>

  <footer class="site-footer">
    <div class="container footer-grid">
      <div class="footer-col">
        <p class="footer-label">{{ site.affiliation }}</p>
        <p class="footer-name">{{ site.name }}</p>
        <p class="footer-text">{{ site.role }}{% if site.location %}<br>{{ site.location }}{% endif %}</p>
      </div>
      <nav class="footer-col" aria-label="Site">
        <ul>
          {%- for item in site.nav | published %}
          <li><a href="{{ item.url }}">{{ item.title }}</a></li>
          {%- endfor %}
          <li><a href="/feed.xml">RSS</a></li>
        </ul>
      </nav>
      <div class="footer-col">
        <ul>
          {%- for l in elsewhere %}
          {%- set href = site.links[l.key] %}
          {%- if href and l.key != "email" %}
          <li><a href="{{ href }}" rel="me">{{ l.label }} ↗</a></li>
          {%- endif %}
          {%- endfor %}
        </ul>
      </div>
      <div class="footer-col footer-actions">
        {%- if site.links.email %}<a class="pill" href="mailto:{{ site.links.email }}">{% icon "mail" %}Email</a>{% endif %}
        <a class="pill" href="{{ site.cv }}">{% icon "cv" %}CV</a>
      </div>
    </div>
    <div class="container footer-bottom">
      <p>© {{ buildYear }} {{ site.name }}</p>
      <p>Set in Inter</p>
    </div>
  </footer>
</body>
</html>
